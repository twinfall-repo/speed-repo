Bootstrap: docker
From: ubuntu:latest

%environment
    export HOME=/root
    export SPEED_FOLDER=${HOME}/speed
    export PATH=${SPEED_FOLDER}:${PATH}

%post
    set -e

    export DEBIAN_FRONTEND=noninteractive
    export HOME_DIR=/root
    export SPEED_FOLDER=${HOME_DIR}/speed

    sed -i 's/^# deb/deb/' /etc/apt/sources.list || true
    apt-get update -y
    apt-get install -y \
        openmpi-bin openmpi-common libopenmpi-dev \
        libmetis5 libmetis-dev \
        wget git bash build-essential gfortran ca-certificates vim
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    git clone https://bitbucket.org/ilmaz/speed.git ${SPEED_FOLDER}
    sed -i 's|^METIS_INCLUDE_FLAGS.*|METIS_INCLUDE_FLAGS = -I/usr/include|' ${SPEED_FOLDER}/Makefile
    sed -i 's|^METIS_LD_FLAGS.*|METIS_LD_FLAGS = -L/usr/lib/x86_64-linux-gnu -lmetis|' ${SPEED_FOLDER}/Makefile
    cd ${SPEED_FOLDER} && make

    cd && mkdir run

%runscript
    cd /root/run
    exec /bin/bash ./run_speed.sh
